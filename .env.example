# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# `.env` is gitignored. This repository is PUBLIC - treat it accordingly.
# ---------------------------------------------------------------------------

# --- Alpaca PAPER trading credentials -------------------------------------
# Generate at: https://app.alpaca.markets/paper/dashboard/overview
# These keys are issued for the PAPER account and cannot touch real money.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# --- Alpaca LIVE credentials ----------------------------------------------
# LEAVE THESE BLANK. Live trading is disabled at build level in this release
# (see app/execution/live_gate.py). Populating them does NOT enable live
# trading; all three independent gates must be opened deliberately.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=

# --- Live trading acknowledgement -----------------------------------------
# One of three required gates for live order submission. Leave unset.
# ALPACA_LIVE_TRADING_ACK=

# --- Overrides ------------------------------------------------------------
# Overrides `mode` in config/config.yaml. One of:
#   signal_only | backtest | paper | live
# TRADING_MODE=signal_only

# Path to the config file (defaults to config/config.yaml)
# TRADING_CONFIG=config/config.yaml
