//@version=5
strategy("Weekly trend filter", overlay=true, initial_capital=50000, default_qty_type=strategy.cash, default_qty_value=20000,
     commission_type=strategy.commission.cash_per_order, commission_value=1)

tf = input.timeframe("W", "Higher timeframe")
htfMa = request.security(syminfo.tickerid, tf, ta.ema(close, 20))
inRange = time >= timestamp(2015, 1, 1, 0, 0)
up = close > htfMa

if inRange and up and ta.crossover(ta.rsi(close, 14), 50)
    strategy.entry("Long", strategy.long)

if bar_index - strategy.opentrades.entry_bar_index(0) >= 10 or close < htfMa
    strategy.close("Long")

plot(htfMa, "Weekly EMA", color=color.purple)
